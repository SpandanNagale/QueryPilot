# Copy to .env and adjust as needed. All QP_-prefixed vars are read by app/config.py's
# Settings; the provider credential vars below are unprefixed on purpose -- they're the
# exact names Render's blueprint (Phase 2d) and the deployment docs use.
QP_READ_ONLY_MODE=false
QP_ROW_IMPACT_CEILING=50
QP_AUTO_LIMIT=200
QP_CONFIRMATION_TIMEOUT_SECONDS=60
QP_GUARDRAIL_MAX_INPUT_CHARS=2000
# Per-IP sliding-window cap on /chat and /confirm requests per 60s.
QP_RATE_LIMIT_PER_MINUTE=10

# Per-session sandbox: each visitor gets their own SQLite copy of data/template.db
# under this directory, so one visitor's writes never affect another's.
QP_SESSION_TTL_MINUTES=30
QP_MAX_SESSIONS=200
# Optional: override where session sandbox files live. Defaults to
# <system temp dir>/qp_sessions -- uncomment only if you need it elsewhere.
# QP_SESSION_DIR=/tmp/qp_sessions

# QP_LLM_PROFILE=local forces every alias (sql_gen, chat) onto a single local
# Ollama deployment -- offline dev only. Leave unset (or "cloud") for the
# normal deployed provider chain in config/model_groups.yaml.
QP_LLM_PROFILE=cloud
QP_OLLAMA_HOST=http://localhost:11434
# Exact-match in-memory cache for intent_classifier/sql_generator LLM calls. Escape hatch -- set false to disable.
QP_LLM_CACHE_ENABLED=true

# --- Cloud LLM provider credentials (config/model_groups.yaml's deployed chain) ---
# Ollama Cloud -- primary provider for sql_gen and chat. Get a key after `ollama signin` at https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CLOUD_HOST=https://ollama.com
# OpenRouter -- second fallback. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Gemini -- third fallback (and Phase 2b's embedding provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq -- last fallback, fast inference. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Operational storage (Phase 2c) ---
# Neon Postgres connection string in production; leave unset for local dev,
# which falls back to a local SQLite file (data/operational.db) automatically.
# Accepts Neon's bare "postgresql://" connection string directly -- it's
# automatically normalized to the psycopg3 dialect ("postgresql+psycopg://").
QP_DATABASE_URL=

# --- Audit access (Phase 2c) ---
# Required in the X-Admin-Token header to read GET /audit's all-sessions log;
# leave unset in local dev if you don't need the admin view.
QP_ADMIN_TOKEN=

# --- CORS ---
# Comma-separated list of allowed origins for the Vercel-hosted frontend
# (Phase 6), e.g. https://querypilot.vercel.app. Empty blocks all cross-origin
# requests -- never combine "*" with credentials.
QP_CORS_ALLOWED_ORIGINS=

# --- Schema retrieval (Phase 2b) ---
# Gemini embedding model used to embed table descriptions for schema
# retrieval, and the output vector dimensionality requested from it.
QP_EMBEDDING_MODEL=gemini-embedding-001
QP_EMBEDDING_DIMENSIONS=768
# Optional: override where the embeddings cache file lives. Defaults to
# data/schema_embeddings.json -- uncomment only if you need it elsewhere.
# QP_SCHEMA_EMBEDDINGS_CACHE_PATH=/absolute/path/to/schema_embeddings.json
